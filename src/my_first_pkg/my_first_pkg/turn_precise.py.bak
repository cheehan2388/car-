import math
import rclpy
from rclpy.node import Node
from geometry_msgs.msg import Twist
from turtlesim.msg import Pose


def normalize(angle):
    """把角度差限制在 -pi ~ pi，避免 3.14 跳到 -3.14 時算錯"""
    return math.atan2(math.sin(angle), math.cos(angle))


class TurnPrecise(Node):
    def __init__(self):
        super().__init__('turn_precise')
        self.pub = self.create_publisher(Twist, '/turtle1/cmd_vel', 10)
        self.sub = self.create_subscription(
            Pose, '/turtle1/pose', self.pose_callback, 10)
        self.timer = self.create_timer(0.05, self.control_loop)

        self.declare_parameter('speed', 1.0)
        self.declare_parameter('laps', 1)

        # self.speed = self.get_parameter('speed').value
        self.target = self.get_parameter('laps').value * 2 * math.pi
        self.last_theta = None        # 上一次的角度（還沒收到資料時是 None）
        self.turned = 0.0             # 累計已經轉了多少

    def pose_callback(self, msg):
        """每收到一次位置就更新累計角度（只記錄，不下指令）"""
        self.get_logger().info('pose_callback 被呼叫了', throttle_duration_sec=1.0)
        if self.last_theta is not None:
            self.turned += normalize(msg.theta - self.last_theta)
        self.last_theta = msg.theta

    def control_loop(self):
        """每 0.05 秒決定一次要轉還是停"""
        self.get_logger().info('control_loop 被呼叫了', throttle_duration_sec=1.0)
        if self.last_theta is None:
            return  # 還沒收到位置，先等

        msg = Twist()
        if self.turned < self.target:
            msg.angular.z = self.speed
            self.get_logger().info(
                f'已轉 {math.degrees(self.turned):.1f} 度',
                throttle_duration_sec=1.0)
        else:
            self.get_logger().info(
                f'完成，共轉了 {math.degrees(self.turned):.1f} 度')
            self.timer.cancel()       # 之後不再呼叫，msg 全是 0 就是停止

        self.pub.publish(msg)


def main():
    rclpy.init()
    node = TurnPrecise()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.try_shutdown()
